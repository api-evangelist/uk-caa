        {
          "id": "3265771c-b80c-4a71-8297-ef714cfd2c3b",
          "name": "Search published consultation activities",
          "request": {
            "name": "Search published consultation activities",
            "description": {
              "content": "Accepts any of the documented search parameters. If no arguments are supplied, all published activities are returned. Any unsupported arguments are ignored. Returns a JSON array of activity objects.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "json_search_results"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "tx",
                  "value": "<string>",
                  "description": "Free text search, case insensitive (eg \"Park\")"
                },
                {
                  "disabled": false,
                  "key": "pc",
                  "value": "<string>",
                  "description": "Postcode, accepts partial postcodes (eg \"BS8\" or \"BS8 111\")"
                },
                {
                  "disabled": false,
                  "key": "st",
                  "value": "<string>",
                  "description": "State, must be one of `open`, `forthcoming` or `closed`"
                },
                {
                  "disabled": false,
                  "key": "au",
                  "value": "<string>",
                  "description": "Audience ID, must be one of the audiences configured on the site"
                },
                {
                  "disabled": false,
                  "key": "in",
                  "value": "<string>",
                  "description": "Interest ID, must be one of the interests configured on the site"
                },
                {
                  "disabled": false,
                  "key": "de",
                  "value": "<string>",
                  "description": "Department the activity sits within. Value must be the same as the ID of a department within the site"
                },
                {
                  "disabled": false,
                  "key": "ar",
                  "value": "<string>",
                  "description": "Area ID, must be one of the areas configured on the site"
                },
                {
                  "disabled": false,
                  "key": "dk",
                  "value": "<string>",
                  "description": "Date search type, must be one of `op` (open date) and `cl` (close date)"
                },
                {
                  "disabled": false,
                  "key": "fd",
                  "value": "<string>",
                  "description": "Date to search from. Must be used in conjunction with `dk` (dd/mm/yyyy)"
                },
                {
                  "disabled": false,
                  "key": "td",
                  "value": "<string>",
                  "description": "Date to search until. Must be used in conjunction with `dk` (dd/mm/yyyy)"
                },
                {
                  "disabled": false,
                  "key": "at",
                  "value": "<string>",
                  "description": "Activity type. Must be one of the activity types available to the site."
                },
                {
                  "disabled": false,
                  "key": "ct",
                  "value": "<string>",
                  "description": "(deprecated) Legacy activity type. Must be one of `QuickConsult` (Online Survey), `File` (Email/Postal Activity), `Document` (Offline Activity), or `Link` (Link)"
                },
                {
                  "disabled": false,
                  "key": "fields",
                  "value": "basic",
                  "description": "Determines which groups of metadata fields about the activities will be returned. Permissible values are 'basic', 'extended' and 'all'. Omitting this parameter is equivalent to 'basic'."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
