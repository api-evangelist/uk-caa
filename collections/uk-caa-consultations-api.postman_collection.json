          "name": "Get one consultation activity by department and activity ID",
          "request": {
            "name": "Get one consultation activity by department and activity ID",
            "description": {
              "content": "Returns a JSON structure containing the same fields as json_search_results. If dept or id are not specified or do not exist, a 404 status code is returned.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "json_consultation_details"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "dept",
                  "value": "<string>",
                  "description": "(Required) The ID of the department (eg 'parks-and-recreation')"
                },
                {
                  "disabled": false,
                  "key": "id",
                  "value": "<string>",
                  "description": "(Required) The ID of the activity (eg 'spring-planting-in-kings-gardens')"
                },
                {
                  "disabled": false,
                  "key": "fields",
                  "value": "basic",
                  "description": "Determines which groups of metadata fields about the activities will be returned. Permissible values are 'basic', 'extended' and 'all'. Omitting this parameter is equivalent to 'basic'."
